{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axezent.ai/schemas/axezent_ai_prk_fuzzer_receipt_v1.schema.json",
  "title": "Axezent AI PRK-Fuzzer Receipt v1",
  "type": "object",
  "required": [
    "schema",
    "truth_label",
    "reduction",
    "input_instance",
    "target_instance",
    "witness",
    "checker_expectation",
    "fuzzer_metadata"
  ],
  "properties": {
    "schema": { "const": "AXEZENT-AI-PRK-RECEIPT-v1" },
    "truth_label": { "const": "BOUNDED_FINITE_REDUCTION_CHECK" },
    "reduction": {
      "type": "object",
      "required": ["name", "source_problem", "target_problem", "version"],
      "properties": {
        "name": { "const": "3SAT_TO_CLIQUE" },
        "source_problem": { "const": "3SAT" },
        "target_problem": { "const": "CLIQUE" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "input_instance": {
      "type": "object",
      "required": ["format", "variables", "clauses"],
      "properties": {
        "format": { "const": "3CNF" },
        "variables": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": true
    },
    "target_instance": {
      "type": "object",
      "required": ["format", "vertices", "edges", "k"],
      "properties": {
        "format": { "const": "GRAPH_WITH_CLIQUE_PARAMETER" },
        "vertices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "k": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "witness": {
      "type": "object",
      "required": ["assignment", "claimed_clique"],
      "properties": {
        "assignment": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "claimed_clique": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "checker_expectation": {
      "type": "object",
      "required": ["expected_result"],
      "properties": {
        "expected_result": { "enum": ["ACCEPT", "REJECT", "INCOMPLETE"] }
      },
      "additionalProperties": true
    },
    "fuzzer_metadata": {
      "type": "object",
      "required": ["generator", "seed", "variable_count", "clause_count", "mutation"],
      "properties": {
        "generator": { "type": "string" },
        "seed": { "type": "integer" },
        "variable_count": { "type": "integer", "minimum": 1 },
        "clause_count": { "type": "integer", "minimum": 1 },
        "mutation": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
